{
  "tests": ["probe.ts", "engine.test.ts"],
  "register": "registerBand",
  "ruleExport": "rule",
  "options": true,
  "types": "types/index.d.ts",
  "nameToken": "band-meters",
  "needs": {
    "ahead-behind": ["calls", "calls-run"],
    "branch-band": ["calls", "calls-run"],
    "ci-band": ["calls", "calls-run", "start-fetch", "turn-run", "ticks"],
    "todo-count": ["calls", "calls-run", "start-fetch", "turn-run", "ticks"],
    "beads-band": ["calls", "calls-run", "start-fetch", "turn-run", "ticks"],
    "bead-now": ["calls", "calls-run", "start-fetch", "turn-run", "ticks"],
    "epic-bar": ["calls", "calls-run", "start-fetch", "turn-run", "ticks"],
    "beads-done-bar": ["calls", "calls-run", "start-fetch", "turn-run", "ticks"],
    "beads-today-bar": ["calls", "calls-run", "start-fetch", "turn-run", "ticks"],
    "priority-bar": ["calls", "calls-run", "start-fetch", "turn-run", "ticks"],
    "battery-band": ["start-fetch", "turn-run", "ticks"],
    "now-playing": ["start-fetch", "turn-run", "ticks"],
    "error-meter": ["calls"],
    "tool-counter": ["calls"],
    "mood-ring": ["calls"],
    "pomodoro": ["ticker", "start-timers"],
    "session-clock": ["ticks"],
    "turn-timer": ["ticks"],
    "daily-spend": ["store"],
    "streak-flame": ["store"],
    "model-badge": ["model"]
  },
  "hosts": {
    "calls": [
      { "file": "hooks/hosts/calls.ts", "export": "watchCalls", "gives": ["calls"] },
      { "file": "hooks/hosts/calls-run.ts", "export": "watchCallsWithRun", "gives": ["calls", "calls-run"] }
    ],
    "tickers": [
      { "file": "hooks/hosts/tickers.ts", "export": "watchTickers", "gives": ["ticker"] }
    ],
    "start": [
      { "file": "hooks/hosts/start.ts", "export": "startSession", "gives": ["start-timers"] },
      { "file": "hooks/hosts/start-run.ts", "export": "startSessionWithFetchers", "gives": ["start-fetch"] }
    ],
    "turn": [
      { "file": "hooks/hosts/turn-end.ts", "export": "endTurns", "gives": [] },
      { "file": "hooks/hosts/turn-end-model.ts", "export": "endTurnsWithModel", "gives": ["model"] },
      { "file": "hooks/hosts/turn-end-store.ts", "export": "endTurnsWithStore", "gives": ["store"] },
      { "file": "hooks/hosts/turn-end-run.ts", "export": "endTurnsWithFetchers", "gives": ["turn-run"] },
      { "file": "hooks/hosts/turn-end-run-store.ts", "export": "endTurnsWithFetchersAndStore", "gives": ["turn-run", "store"] }
    ],
    "end": [
      { "file": "hooks/hosts/session-end.ts", "export": "stopTicks", "gives": ["ticks"] }
    ]
  },
  "userConfig": {
    "latte-meter": {
      "lattePrice": {
        "type": "number",
        "title": "Latte price",
        "description": "What one latte costs, in the currency of the session cost (US dollars). The latte meter divides the cost by it.",
        "default": 5.0
      }
    },
    "beads-today-bar": {
      "dailyGoal": {
        "type": "number",
        "title": "Daily bead goal",
        "description": "How many beads you aim to close each day, 1 to 50. The today bar turns green when the beads closed today reach it.",
        "default": 5,
        "min": 1,
        "max": 50
      }
    }
  }
}
